# DeviantDrop 服务器运行配置（复制为 .env 使用；已被 .gitignore 排除）
# Telegram Bot（@BotFather 创建）
BOT_TOKEN=123456789:replace_me
# webhook 鉴权密钥（长轮询模式不参与鉴权，但必填）：openssl rand -hex 32
WEBHOOK_SECRET=replace_with_a_random_string
# 接入模式：poll=长轮询（无公网入口，默认，国内服务器推荐）| webhook=需 HTTPS 反代
MODE=poll
# 监听端口（poll 与 webhook 都会启动 HTTP server，提供 /health 与 Web 登录回调）
PORT=8080
# 默认只监听回环地址；同机 HTTPS 反向代理转发到这里。
HTTP_HOST=127.0.0.1
# 公网可访问的本站地址（用于 Telegram 内 /login 的 Web OAuth 回调）。
# poll 模式也要填：管理员发 /login 后浏览器打开该地址完成授权，无需 SSH/重启。
# 例：https://bot.your-domain.com  （需把 /auth/deviantart/callback 加进 DA 应用 redirect 白名单）
PUBLIC_BASE_URL=

# DeviantArt 官方 API 凭据（deviantart.com/developers 注册 Confidential 应用）
# 不填则尝试匿名网页路径（仅当该出口未被 DA 封禁时可用）
CLIENT_ID=
CLIENT_SECRET=

# 管理员 Telegram 用户 id（逗号分隔）。/login、/status 仅管理员可用；未设置且 ALLOWED_USER_IDS 也为空时拒绝所有管理命令；管理命令只允许私聊。
ADMIN_IDS=

# （可选）DeviantArt 登录 Cookie，用于下载需登录/成熟内容：
# 浏览器登录 deviantart.com 后，从 Cookie 里复制 auth、auth_secure、userinfo 三项，
# 格式：auth=xxx; auth_secure=xxx; userinfo=xxx
# 注意：DA_COOKIES 只在首次启动时迁移到 /data/auth/deviantart-cookies.json，之后以该文件为准、支持热更新。
DA_COOKIES=

# DeviantArt 用户 OAuth 登录：推荐直接在 Telegram 发 /login 走 Web 授权（无需重启）。
# DA_REFRESH_TOKEN 仅作为「首次迁移 seed」：会写入 /data/auth/deviantart.json，之后轮换/失效都以该文件为准，
# 不再回退读这里的旧值。也可用命令行 `node scripts/da-login.mjs <client_id>` 登录（开发/CLI 辅助）。
DA_REFRESH_TOKEN=

# 认证文件目录（默认 /data/auth，随 cache named volume 持久化）。一般不用改。
AUTH_DIR=/data/auth

# （可选）默认不抓原图、直接用最高清展示图（免费账号原图有日配额）；设 1 才优先原图。
PREFER_ORIGINAL=

# 可选：逗号分隔的 Telegram 用户 id，留空允许所有人
ALLOWED_USER_IDS=

# —— TelePress（可选）：超大图集 / Telegram 发送失败时，额外生成 Telegraph 页面 ——
# TelePress 地址；同机部署建议 http://127.0.0.1:<port>，不要把无鉴权发布接口暴露公网。
TELEPRESS_URL=
# TelePress 侧配置的 TELEPRESS_API_KEY（Bearer 鉴权）；两端填同一个。
TELEPRESS_API_KEY=
# off(永不调用) | fallback(仅 Telegram 失败兜底) | large-gallery(图片>10 主动建页) | always(不推荐)
TELEPRESS_MODE=fallback

# 国内服务器出口代理（clash/mihomo 等）；留空则直连
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
