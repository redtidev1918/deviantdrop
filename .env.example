# DeviantDrop 服务器运行配置（复制为 .env 使用；已被 .gitignore 排除）
# Telegram Bot（@BotFather 创建）
BOT_TOKEN=123456789:replace_me
# webhook 鉴权密钥（长轮询模式不参与鉴权，但必填）：openssl rand -hex 32
WEBHOOK_SECRET=replace_with_a_random_string
# 接入模式：poll=长轮询（无公网入口，默认，国内服务器推荐）| webhook=需 HTTPS 反代
MODE=poll
# 监听端口（仅 webhook 模式用到）
PORT=8080

# DeviantArt 官方 API 凭据（deviantart.com/developers 注册 Confidential 应用）
# 不填则尝试匿名网页路径（仅当该出口未被 DA 封禁时可用）
CLIENT_ID=
CLIENT_SECRET=

# （可选）DeviantArt 登录 Cookie，用于下载需登录/成熟内容：
# 浏览器登录 deviantart.com 后，从 Cookie 里复制 auth、auth_secure、userinfo 三项，
# 格式：auth=xxx; auth_secure=xxx; userinfo=xxx
# 账号需在 DA 设置里开启「显示成熟内容」，否则仍拿不到原图。
DA_COOKIES=

# （推荐，替代 Cookie）DeviantArt 用户 OAuth 登录：运行 `node scripts/da-login.mjs <client_id>` 登录一次得到 refresh token，填入后 Bot 自动续期，成熟内容原图不再依赖会过期的 Cookie。
DA_REFRESH_TOKEN=

# （可选）轮换后的 refresh token 持久化文件（独立于 cache，清缓存后仍可续期）。默认 /data/refresh_token。
REFRESH_TOKEN_FILE=/data/refresh_token

# （可选）默认不抓原图、直接用最高清展示图（免费账号原图有日配额）；设 1 才优先原图。
PREFER_ORIGINAL=

# 可选：逗号分隔的 Telegram 用户 id，留空允许所有人
ALLOWED_USER_IDS=

# 国内服务器出口代理（clash/mihomo 等）；留空则直连
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
